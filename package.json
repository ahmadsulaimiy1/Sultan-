{
  "name": "sultan-hanafi-royal-schools",
  "private": true,
  "version": "1.0.0",
  "description": "Sultan Hanafi Royal Schools — website build scripts, Parent Portal API, and AI assistant, deployed as Cloudflare Pages + Pages Functions with a Neon Postgres database",
  "scripts": {
    "build": "node scripts/build.js",
    "i18n:check": "node scripts/i18n-check.js",
    "i18n:check:strict": "node scripts/i18n-check.js --strict",
    "i18n:templatise": "node scripts/i18n-templatise.js",
    "i18n:portal": "node scripts/i18n-portal.js && node scripts/i18n-portal-assets.js",
    "test:i18n": "node scripts/test-i18n-switcher.mjs && node scripts/test-i18n-portal.mjs",
    "certificates:import": "node scripts/build-production-import.mjs",
    "certificates:accept": "node scripts/verify-certificate-acceptance.mjs",
    "certificates:rehearse": "node --import ./scripts/_lib/neon-pg-register.mjs scripts/verify-certificate-acceptance.mjs",
    "test:offline": "node scripts/test-offline-foundation.mjs",
    "test:offline:shell": "node scripts/test-offline-shell.mjs",
    "test:sync": "node scripts/test-sync-engine.mjs",
    "test:search": "node scripts/test-offline-search.mjs",
    "test:certificate-offline": "node scripts/test-certificate-offline.mjs",
    "certificates:register": "node scripts/build-certificate-register.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.2.0",
    "@neondatabase/serverless": "^0.10.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "pg": "^8.13.0"
  }
}
