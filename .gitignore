node_modules/
.wrangler/
.dev.vars
.dev.vars.*

# Regenerable binary exports — source of truth is prospectus/index.html
# (PDF) and scripts/generate-prospectus-docx.js (DOCX), not these files.
prospectus/exports/

# Regenerable binary exports — source of truth is
# docs/shrs-constitution-2026-draft.md and
# scripts/generate-constitution-docx.js, not these files.
docs/exports/

# Machine-specific Puppeteer config written by mermaid-rendering scripts
.puppeteer-config.json

# Rendered certificate batches are regenerated by
# scripts/issue-certificate-batch.mjs; the registers they produce are
# committed under docs/graduation-registers/ instead.
dist/certificates/

# Ground-plate proofs are regenerated by
# scripts/verify-certificate-ground.mjs --render (31MB at 600 DPI); the
# module and its gate are the committed source, not the rasters.
build/certificate-ground/
build/certificate-plate/
