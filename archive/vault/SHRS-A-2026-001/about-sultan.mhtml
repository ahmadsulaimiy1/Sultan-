.gt_float_switcher .gt-selected .gt-current-lang span.gt_float_switcher-arrow { display: inline-block; height: 24px; width: 15px; vertical-align: middle; background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 285 285'><path d='M282 76.5l-14.2-14.3a9 9 0 0 0-13.1 0L142.5 174.4 30.3 62.2a9 9 0 0 0-13.2 0L3 76.5a9 9 0 0 0 0 13.1l133 133a9 9 0 0 0 13.1 0l133-133a9 9 0 0 0 0-13z' style='fill:%23666'/></svg>"); background-position: 50% center; background-size: 11px; background-repeat: no-repeat; transition: 0.3s; transform: rotate(-180deg); }

